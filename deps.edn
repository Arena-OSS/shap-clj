{:paths ["src"]

 :deps
 {org.clojure/clojure               {:mvn/version "1.12.1"}
  org.clojure/math.combinatorics    {:mvn/version "0.3.0"}}

 :aliases
 {:test
  {:extra-paths ["test"]
   :extra-deps {io.github.cognitect-labs/test-runner
                {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
   :main-opts ["-m" "cognitect.test-runner"]
   :exec-fn cognitect.test-runner.api/test}

  ;; Optional: Tablecloth-dataset coercion in shap-clj.coerce.tablecloth
  :tablecloth
  {:extra-deps {scicloj/tablecloth {:mvn/version "7.062"}}}

  ;; Optional: Deep Diamond adapter in shap-clj.adapter.deep-diamond
  :dd
  {:extra-deps {uncomplicate/deep-diamond {:mvn/version "0.43.0"}}
   :jvm-opts ["--enable-native-access=ALL-UNNAMED"
              "--add-opens=java.base/java.lang=ALL-UNNAMED"]}

  ;; Optional: Neanderthal linear algebra backend
  :neanderthal
  {:extra-deps {uncomplicate/neanderthal {:mvn/version "0.49.1"}}}

  ;; Everything — used by tests that exercise adapters
  :all
  {:extra-deps {scicloj/tablecloth         {:mvn/version "7.062"}
                uncomplicate/deep-diamond  {:mvn/version "0.43.0"}
                uncomplicate/neanderthal   {:mvn/version "0.49.1"}}
   :jvm-opts ["--enable-native-access=ALL-UNNAMED"
              "--add-opens=java.base/java.lang=ALL-UNNAMED"]}}}
